# Copy this file to .env and adjust. Every key below is optional: the defaults
# in mediaforge/config.py are used when it is absent.

# ── Logging / state ──────────────────────────────────────────────────────────
MF_LOG_LEVEL=INFO
# MF_LOG_DIR=%ProgramData%\media-forge\logs
# MF_STATE_DIR=%ProgramData%\media-forge

# ── Clone tree ───────────────────────────────────────────────────────────────
# symlink (default) = zero bytes, and the space is freed the moment a source is
# deleted; hardlink = the pre-2026-11-13 behaviour (data survives until every
# name is gone, and the clone root must share a volume with every source).
MF_LINK_MODE=symlink
MF_CLONE_ROOT=D:\Media\Jellyfin
MF_LIBRARY_MOVIES=Movies
MF_LIBRARY_SHOWS=Shows
MF_LIBRARY_ANIME=Anime

# How often the idle liveness sweep runs (a delete event schedules one sooner),
# and how long a source must stay gone before its entry is pruned (a downloader
# replacing a file briefly removes it; the grace window keeps the mirror from
# flapping). 0 for the interval disables the idle sweep.
MF_LIVENESS_INTERVAL_SECONDS=30
MF_LIVENESS_GRACE_SECONDS=2
# A second, slower walk of the clone tree removes dangling links with no
# database row (a restored state dir, a run killed mid-item). 0 disables it.
MF_ORPHAN_SCAN_INTERVAL_SECONDS=60

# ── Sources ──────────────────────────────────────────────────────────────────
# root id -> folder. Leave a source empty to disable it. The two examples are
# commented out on purpose: `init` copies this file to .env, and a fresh install
# must not point at somebody else's folders.
# MF_SOURCE_SHOWS=D:\Shows\my-library
# MF_SOURCE_ANIME=D:\Shows\my-anime
# MF_SOURCE_SKILLCAPPED=

# Comma-separated fnmatch patterns for FOLDERS: a folder whose name, or whose
# path relative to the source root, matches is not scanned at all, so nothing
# under it is ever mirrored. Names starting with "." are always skipped.
# MF_EXCLUDE=Extras,*/Sample,*_deleted

# Force a plugin instead of scoring, e.g. MF_PLUGIN_OVERRIDE_ANIME=animeunity
# MF_PLUGIN_OVERRIDE_SHOWS=
# MF_PLUGIN_OVERRIDE_ANIME=

# Detection floor: below this, a root is refused rather than guessed.
MF_PLUGIN_MIN_CONFIDENCE=0.60
MF_PLUGIN_DIR=plugins

# ── Watching ─────────────────────────────────────────────────────────────────
# events (default) = OS file events decide when to look, and the stat signature
# decides what is true; poll = no events at all (a share, or a debugger);
# off = refuse to start a daemon.
MF_WATCH_MODE=events
# Only roots that emit no events are walked on this clock (network shares).
MF_POLL_INTERVAL_SECONDS=15
# A root keeps re-arming while it changes, so a file still being written is not
# reconciled mid-download.
MF_SETTLE_SECONDS=20
# Two runs of the same root are never closer than this.
MF_MIN_GAP_SECONDS=30
# The safety net: a full pass anyway, because an event can be missed.
MF_SCAN_FULL_INTERVAL_SECONDS=21600
MF_STARTUP_GRACE_SECONDS=60

# ── Safety ───────────────────────────────────────────────────────────────────
MF_DRY_RUN=false
MF_PRUNE_ENABLED=true
MF_PRUNE_REQUIRE_KNOWN_INODE=true
MF_MANAGED_EXTENSIONS=.mkv,.mp4,.nfo

# ── Naming / metadata ────────────────────────────────────────────────────────
MF_RESOLUTION_PREFERENCE=1080p,720p
# false = place mapped shows in their provider's seasons (arc seasons for One
# Piece); true = one flat Season 01 with absolute episode numbers.
MF_ANIME_SINGLE_SEASON=false
MF_ANIME_MOVIE_HINTS=\b(Movie|Film)\b
# Optional: read the season map from another JSON file instead of the copy that
# ships beside the plugin (plugins/anime_seasons.json). Empty = the shipped map.
MF_SEASON_MAP=

# ── NFO ──────────────────────────────────────────────────────────────────────
MF_NFO_ENABLED=true
MF_NFO_SORTTITLE=true
MF_NFO_SET=true

# ── Jellyfin ─────────────────────────────────────────────────────────────────
MF_JELLYFIN_URL=http://127.0.0.1:8096
# Empty = refresh disabled; the tool stays fully usable.
MF_JELLYFIN_API_KEY=
MF_JELLYFIN_REFRESH=true
MF_JELLYFIN_REFRESH_DEBOUNCE_SECONDS=60
MF_JELLYFIN_REFRESH_TIMEOUT_SECONDS=120
# Filled in by `mediaforge jellyfin-check`.
# MF_JELLYFIN_LIB_MOVIES=
# MF_JELLYFIN_LIB_SHOWS=
# MF_JELLYFIN_LIB_ANIME=

# ── Seldom needed ────────────────────────────────────────────────────────────
# The checkout whose .env is read and whose plugins/ is loaded by default.
# Set it only when the code does not sit beside its plugins.
# MF_ROOT=

